
// Enum definitions for roles and statuses
enum user_role {
  user
  admin
}

enum resource_status {
  available
  unavailable
}

enum booking_status {
  pending
  confirmed
  cancelled
  rejected
}

enum notification_type {
  booking_update
  announcement
}


// Table for users (students, faculty, admins)
Table users {
  id int [pk, increment]
  name varchar(255) [not null]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  role user_role [not null]
  created_at timestamp [default: `now()`, not null]
  updated_at timestamp [default: `now()`, not null]
}

// Table for resource categories
Table resource_categories {
  id int [pk, increment]
  name varchar(100) [unique, not null]
  description text
}

// Table for all bookable resources
Table resources {
  id int [pk, increment]
  name varchar(255) [not null]
  description text
  category_id int [not null]
  location varchar(255)
  capacity int
  image_url varchar(255)
  status resource_status [not null, default: 'available']
  requires_approval boolean [not null, default: false]
  created_at timestamp [default: `now()`, not null]
  updated_at timestamp [default: `now()`, not null]

  indexes {
    category_id
  }
}

// Core table for all bookings
Table bookings {
  id int [pk, increment]
  user_id int [not null]
  resource_id int [not null]
  start_time timestamp [not null]
  end_time timestamp [not null]
  purpose text
  status booking_status [not null, default: 'pending']
  created_at timestamp [default: `now()`, not null]
  updated_at timestamp [default: `now()`, not null]

  indexes {
    (resource_id, start_time, end_time) // Critical for conflict checking
    user_id
  }
}

// Table for recurring weekly availability
Table availability_rules {
  id int [pk, increment]
  resource_id int [not null]
  day_of_week int [not null, note: '0=Sunday, 1=Monday, ..., 6=Saturday']
  open_time time [not null]
  close_time time [not null]

  indexes {
    resource_id
  }
}

// Table for one-off availability changes (holidays, maintenance)
Table availability_exceptions {
  id int [pk, increment]
  resource_id int [not null]
  start_datetime timestamp [not null]
  end_datetime timestamp [not null]
  is_unavailable boolean [not null, default: true]
  reason varchar(255)

  indexes {
    resource_id
  }
}

// (Bonus) Table for notifications
Table notifications {
  id int [pk, increment]
  user_id int [not null]
  title varchar(255) [not null]
  message text [not null]
  is_read boolean [not null, default: false]
  type notification_type [not null]
  related_booking_id int [null]
  created_at timestamp [default: `now()`, not null]

  indexes {
    user_id
  }
}


// --- Relationships ---
// Using > for one-to-many relationships

Ref: resources.category_id > resource_categories.id

Ref: bookings.user_id > users.id
Ref: bookings.resource_id > resources.id

Ref: availability_rules.resource_id > resources.id
Ref: availability_exceptions.resource_id > resources.id

Ref: notifications.user_id > users.id
Ref: notifications.related_booking_id > bookings.id